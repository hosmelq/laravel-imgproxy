{
    "name": "hosmelq/laravel-imgproxy",
    "description": "Build imgproxy URLs in Laravel with optional encryption and signing.",
    "license": "MIT",
    "keywords": [
        "encryption",
        "image-processing",
        "image-transforms",
        "imgproxy",
        "imgproxy-php",
        "laravel",
        "laravel-imgproxy",
        "php",
        "signed-urls",
        "url-builder"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "hosmelq/imgproxy": "^1.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "hosmelq/php-coding-standard": "^1.1",
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.1",
        "orchestra/testbench": "^10.9 || ^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-rector": "^5.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "thecodingmachine/safe": "^3.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\Imgproxy\\Laravel\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\Imgproxy\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "HosmelQ\\Imgproxy\\Laravel\\ImgproxyServiceProvider"
            ]
        }
    },
    "scripts": {
        "ecs": "ecs check --fix=true",
        "ecs:check": "ecs check",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Format PHP code using the shared ECS set.",
        "ecs:check": "Check PHP formatting using the shared ECS set.",
        "phpstan": "Run PHPStan static analysis.",
        "rector": "Run Rector automated refactoring.",
        "test": "Run the test suite using Pest.",
        "test-coverage": "Run the test suite with code coverage using Pest."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
